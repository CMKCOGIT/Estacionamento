# App do cliente (PWA) — usado no build (npm run build -w @estacionamento/pwa).
# Endereço da API pública externa. Em produção TEM que ser https:// (o build recusa http).
VITE_API_URL=http://localhost:8090
# Estacionamento mostrado na tela inicial (slug cadastrado no servidor local).
VITE_SITE_SLUG=estacionamento-demonstracao
