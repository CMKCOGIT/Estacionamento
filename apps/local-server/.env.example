# =============================================================================
# Servidor Local — copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env NUNCA deve ser enviado ao Git (já está no .gitignore).
# =============================================================================

# Ambiente: development | test | production
NODE_ENV=development

# Endereço e porta da API/painel.
# 0.0.0.0 = aceita conexões de outros PCs da rede local do estacionamento.
# 127.0.0.1 = somente neste computador.
HOST=0.0.0.0
PORT=8080

# Nível de log: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Origens liberadas no CORS (separadas por vírgula). Só é necessário em
# desenvolvimento, quando o painel roda no Vite (porta 5173).
CORS_ORIGINS=http://localhost:5173

# --- MySQL local ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=estacionamento
DB_POOL_SIZE=10

# Fuso do estacionamento (offset fixo). Brasília = -03:00
FUSO_OFFSET=-03:00

# --- Login e sessões ------------------------------------------------------------
# Sessão expira após X minutos sem uso, e no máximo após Y horas (um turno).
SESSAO_INATIVIDADE_MIN=60
SESSAO_DURACAO_MAX_HORAS=12
# Após N senhas erradas seguidas, a conta fica bloqueada por M minutos.
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MIN=15
# Máximo de logins com falha por computador (IP) a cada 15 minutos.
LOGIN_LIMITE_POR_IP=20
# true SOMENTE se o painel for acessado por HTTPS (senão o login não funciona).
# Também ativa os cabeçalhos de segurança exclusivos de HTTPS (HSTS).
COOKIE_SECURE=false

# --- Painel administrativo ------------------------------------------------------
# true = este servidor também entrega o painel já compilado (apps/admin-web/dist)
SERVE_ADMIN_WEB=true

# --- App do cliente e sincronização com a API externa (nuvem) -------------------
# Endereço do app do cliente: é o link do QR Code de cada ticket.
# PUBLIC_PWA_URL=https://estacionamento.pages.dev
#
# Envio dos dados para a API externa. Crie a credencial no servidor da API:
#   npm run integracao -w @estacionamento/cloud-api -- criar --nome "Estacionamento Centro"
# e copie as duas linhas que ela mostrar. Sem estas três, o envio fica desligado
# (o estacionamento funciona normalmente; só o app do cliente não recebe dados).
# Em produção, CLOUD_API_URL precisa ser https://
# CLOUD_API_URL=https://api.seuestacionamento.com.br
# SYNC_INTEGRACAO_ID=
# SYNC_SECRET=
