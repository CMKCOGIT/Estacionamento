{
  "name": "@estacionamento/local-server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor local: API REST do painel administrativo (funciona sem internet)",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integracao": "vitest run --project integracao",
    "db:migrar": "tsx scripts/db-migrar.ts",
    "db:criar": "tsx scripts/db-migrar.ts",
    "usuario:admin": "tsx scripts/criar-admin.ts",
    "demo:criar": "tsx scripts/dados-demonstracao.ts",
    "https:certificado": "tsx scripts/certificado-https.ts",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@estacionamento/calculo": "*",
    "@estacionamento/shared": "*",
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.2.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "ulid": "^3.0.2",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.0",
    "tsx": "^4.23.0"
  }
}
