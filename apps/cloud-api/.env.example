# API externa (nuvem) — copie para .env e ajuste.
NODE_ENV=development
PORT=8090
HOST=0.0.0.0
LOG_LEVEL=info

# Banco da NUVEM (modelo de leitura). Em produção: MySQL do provedor.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=estacionamento_nuvem

# Endereço do PWA do cliente: o único autorizado a chamar a API pelo navegador (CORS).
# Vários separados por vírgula. Ex.: https://estacionamento.pages.dev
PWA_ORIGENS=http://localhost:5174,https://localhost:5174

# Produção atrás do proxy do provedor (Render, Railway...): exige HTTPS.
# FORCAR_HTTPS=true
# CONFIAR_PROXY=1

# Consultas de ticket por IP por minuto (proteção contra tentativas).
LIMITE_TICKET_POR_MINUTO=30

# Ferramenta de desenvolvimento (npm run espelhar:local): banco LOCAL de origem.
# Substituída pela sincronização automática quando ela for implementada.
LOCAL_DB_NAME=estacionamento_demo
