# API externa (nuvem) — copie para .env e ajuste.
NODE_ENV=development
PORT=8090
HOST=0.0.0.0
LOG_LEVEL=info

# Banco da NUVEM (modelo de leitura). Em produção: MySQL do provedor.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=estacionamento_nuvem

# Endereço do PWA do cliente: o único autorizado a chamar a API pelo navegador (CORS).
# Vários separados por vírgula. Ex.: https://estacionamento.pages.dev
PWA_ORIGENS=http://localhost:5174,https://localhost:5174

# Produção atrás do proxy do provedor (Render, Railway...): exige HTTPS.
# FORCAR_HTTPS=true
# CONFIAR_PROXY=1

# Limites da consulta do ticket (por minuto). Muitos clientes podem dividir o
# mesmo IP (operadora de celular), então por IP só contam as consultas que falham.
# Consultas que falham (link inexistente) por IP — contra quem tenta adivinhar links:
LIMITE_TICKET_POR_MINUTO=30
# Consultas de um mesmo ticket (o app consulta a cada 30 s):
LIMITE_TICKET_POR_TOKEN_POR_MINUTO=12
# Teto de consultas por IP:
LIMITE_TICKET_TETO_POR_IP_POR_MINUTO=1200

# Sincronização (servidor local → nuvem). Chave mestra das integrações: um texto
# aleatório e secreto de 32+ caracteres (ex.: openssl rand -base64 48). O segredo
# de cada estacionamento é derivado dela. Sem ela, /sync/v1 fica desligado.
# SYNC_CHAVE_MESTRA=
# LIMITE_SYNC_POR_MINUTO=240

# Registro de requisições (tabela registro_api): por quantos dias guardar, e a
# chave que anonimiza o IP (sem ela, uma aleatória a cada início).
# DIAS_REGISTRO=30
# CHAVE_REGISTRO=

# MySQL do provedor (Aiven, Railway...) exige conexão criptografada.
# DB_SSL=true
# DB_SSL_CA=<texto do "CA certificate" do provedor, ou caminho do arquivo>
