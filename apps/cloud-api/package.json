{
  "name": "@estacionamento/cloud-api",
  "version": "0.1.0",
  "private": true,
  "description": "API externa (nuvem): API pública /v1 consumida pelo PWA do cliente. Só leitura, sem funções administrativas.",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:integracao": "vitest run",
    "db:migrar": "tsx scripts/db-migrar.ts",
    "espelhar:local": "tsx scripts/espelhar-local.ts"
  },
  "dependencies": {
    "@estacionamento/calculo": "*",
    "@estacionamento/shared": "*",
    "dotenv": "^18.0.10",
    "express": "^5.2.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.0"
  }
}
